# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it's gitignored by Next.js by default.
# This file (.env.example) IS committed — keep placeholders only, never real keys.

# --- Stripe (payments) ---
# Get from https://dashboard.stripe.com → Developers → API keys (use TEST keys until going live)
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- Supabase (database) ---
# Get from https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx
# Service role key — server-only, NEVER expose to the client (no NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# --- Cloudflare Turnstile (CAPTCHA) ---
# Get from https://dash.cloudflare.com → Turnstile → Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAxxxxxx

# --- Resend (emails) ---
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_xxx
# Email address that receives contact form and event registration notifications
NOTIFICATION_EMAIL=brad@bodybybrad.com

# --- App ---
# Used by Stripe Checkout for success/cancel redirect URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated emails that get /admin access. Must match the email of a Supabase Auth user.
ADMIN_EMAILS=you@example.com

# --- Google Analytics 4 ---
# Get from https://analytics.google.com → Admin → Data Streams → your web stream
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
